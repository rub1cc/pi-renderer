{
  "name": "@rub1cc/pi-renderer",
  "version": "0.1.0",
  "description": "Compact Codex-style tool rendering for Pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rub1cc/pi-renderer.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./renderers": "./renderers.ts"
  },
  "files": [
    "index.ts",
    "cancellation.ts",
    "compaction.ts",
    "components.ts",
    "assistant-replies.ts",
    "user-messages.ts",
    "sticky-prompt.ts",
    "labels.ts",
    "generic.ts",
    "group-model.ts",
    "renderers.ts",
    "read-groups.ts",
    "working-indicator.ts",
    "web.ts",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'TypeScript source is loaded directly by Pi'",
    "check": "bun test",
    "test": "bun test"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "renderer",
    "codex"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@rub1cc/pi-apply-patch": "0.1.0"
  },
  "bundledDependencies": [
    "@rub1cc/pi-apply-patch"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
